# StyleMirror Backend Configuration (No Docker, Python venv)

# Multiple Gemini API keys separated by commas for round-robin rotation
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# AI Provider choice: gemini or mock
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=mock

# Database & Storage
DATABASE_URL=sqlite:///./stylemirror.db
STORAGE_DIR=./storage

# Security & Safety
SECRET_KEY=stylemirror-super-secret-key-change-in-production
ALLOWED_ORIGIN=*
DAILY_GENERATION_CAP=50
RATE_LIMIT_PER_MINUTE=20
PHOTO_TTL_HOURS=24
